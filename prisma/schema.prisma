  breakHours        Decimal        @default(0) @map("break_hours") @db.Decimal(5, 2)
  regularHours      Decimal        @map("regular_hours") @db.Decimal(6, 2)
  status            ApprovalStatus @default(PENDING)
  /// "employeeId|workDate|startTime" while the entry is active; NULL once rejected/cancelled. Unique → no duplicates.
  activeKey         String?        @unique @map("active_key") @db.VarChar(100)
