# ─────────────────────────────────────────────────────────────────────────────
# eQwik YardHRMS(TM) — environment template. Copy to .env and fill in values.
# NEVER commit real secrets. Generate keys with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="eQwik YardHRMS"

# API
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
HRMS_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
# Comma-separated origins allowed for CORS and Origin checks on auth endpoints
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false

# MySQL 8.4 LTS (InnoDB, utf8mb4)
DATABASE_URL=mysql://yard:change-me@127.0.0.1:3306/yardhrms
# Used only by integration tests (database is reset by the test runner)
TEST_DATABASE_URL=mysql://yard:change-me@127.0.0.1:3306/yardhrms_test

# Redis (rate limiting; falls back to in-memory limiter when unavailable in development)
REDIS_URL=redis://127.0.0.1:6379

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false
# Field-level encryption key for TRN/NIS/NHT, bank accounts and MFA secrets (32 bytes, base64)
FIELD_ENCRYPTION_KEY=
# Pepper/HMAC key for hashing session tokens and activation codes (32 bytes, base64)
TOKEN_HMAC_KEY=

# MFA enforcement: "required" enforces MFA for Qwik staff and tenant Admin/Payroll/Finance roles (SEC-006).
# "optional" may be used ONLY in local development.
MFA_ENFORCEMENT=required
MFA_ISSUER="eQwik YardHRMS"

# Object storage: "local" (development) or "s3" (S3-compatible, private bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=yardhrms-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Server-side encryption request header: AES256 | aws:kms | none.
S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_UPLOAD_MB=10

# Email (SMTP). In development, leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eQwik YardHRMS <no-reply@example.com>"

# Payroll compliance gate. Keep false until a qualified Jamaican payroll specialist has signed off the
# statutory rules package and reference calculations. While false, payslips carry a NOT CERTIFIED banner.
PAYROLL_COMPLIANCE_CERTIFIED=false

# Worker
WORKER_POLL_MS=2000
WORKER_ID=worker-1

# Seed (development only) — initial Qwik super admin. Leave blank to skip.
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
# Create a demo tenant with sample data (development only)
SEED_DEMO_TENANT=false

# Licence Manager: require a different Qwik officer to verify a payment than the one who recorded it (PRD §17 open decision)
PAYMENT_REQUIRE_SEPARATE_VERIFIER=true

# Billing documents (invoices, receipts, statements) issued by Qwik Business Solutions.
# GCT: leave BILLING_GCT_RATE=0 unless Qwik is registered for GCT (standard rate 0.15) and BILLING_GCT_NUMBER is set.
BILLING_SELLER_NAME="Qwik Business Solutions"
BILLING_SELLER_ADDRESS="Kingston, Jamaica"
BILLING_SELLER_EMAIL=billing@example.com
BILLING_SELLER_TRN=
BILLING_GCT_NUMBER=
BILLING_GCT_RATE=0
BILLING_PAYMENT_INSTRUCTIONS="Pay by bank transfer, cash or cheque. Quote the invoice number as your payment reference."
BILLING_INVOICE_DUE_DAYS=14

# Single sign-on (optional). Register the redirect URI <HRMS_WEB_URL>/api/v1/auth/sso/<provider>/callback
# with each provider. Users must already exist (registered or invited); MFA is still required for privileged roles.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
# organizations = any work/school directory; or a specific directory (tenant) id to restrict sign-in
OIDC_MICROSOFT_TENANT=organizations
