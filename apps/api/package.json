{
  "name": "@yardhrms/api",
  "version": "0.1.0",
  "private": true,
  "description": "eQwik YardHRMS REST API (NestJS, Prisma, MySQL)",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "seed": "node -r dotenv/config dist/seed/seed.js dotenv_config_path=../../.env",
    "seed:dev": "ts-node --transpile-only -r dotenv/config src/seed/seed.ts dotenv_config_path=../../.env",
    "openapi": "node -r dotenv/config dist/openapi.js dotenv_config_path=../../.env",
    "test": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.0",
    "@yardhrms/authorization": "workspace:*",
    "@yardhrms/payroll-engine": "workspace:*",
    "@yardhrms/types": "workspace:*",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jszip": "3.10.2",
    "multer": "2.0.2",
    "nodemailer": "7.0.10",
    "otplib": "12.0.1",
    "pdfkit": "0.17.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.12",
    "@types/nodemailer": "7.0.2",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
