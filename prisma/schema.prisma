// ────────────────────────────────────────────────────────────────────────────
// Statutory rules & payroll
// ────────────────────────────────────────────────────────────────────────────

model StatutoryRuleVersion {
  id              String            @id @default(uuid()) @db.Char(36)
  tenantId        String            @map("tenant_id") @db.Char(36)
  name            String            @db.VarChar(120)
  effectiveFrom   DateTime          @map("effective_from") @db.Date
  effectiveTo     DateTime?         @map("effective_to") @db.Date
  status          RuleVersionStatus @default(DRAFT)
  sourceReference String?           @map("source_reference") @db.VarChar(500)
  attestation     String?           @db.VarChar(1000)
  createdById     String?           @map("created_by_id") @db.Char(36)
  approvedById    String?           @map("approved_by_id") @db.Char(36)
  approvedAt      DateTime?         @map("approved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  components StatutoryComponent[]

  @@unique([tenantId, id])
  @@index([tenantId, status, effectiveFrom])
  @@map("statutory_rule_versions")
}

model StatutoryComponent {
  id                     String        @id @default(uuid()) @db.Char(36)
  tenantId               String        @map("tenant_id") @db.Char(36)
  versionId              String        @map("version_id") @db.Char(36)
  code                   String        @db.VarChar(20)
  name                   String        @db.VarChar(80)
  sortOrder              Int           @map("sort_order")
  base                   StatutoryBase
  employeeRate           Decimal       @map("employee_rate") @db.Decimal(9, 6)
  employerRate           Decimal       @map("employer_rate") @db.Decimal(9, 6)
  annualCeiling          Decimal?      @map("annual_ceiling") @db.Decimal(18, 2)
  annualThreshold        Decimal?      @map("annual_threshold") @db.Decimal(18, 2)
  reducesStatutoryIncome Boolean       @default(false) @map("reduces_statutory_income")
  minAge                 Int?          @map("min_age")
  maxAge                 Int?          @map("max_age")
  /// PERIOD (each pay period alone) or CUMULATIVE (year-to-date recalculation within the tax year)
  calculationMethod      StatutoryCalculationMethod @default(PERIOD) @map("calculation_method")
  /// Whether bracket bounds apply to the base before or after the threshold
  bracketBasis           BracketBasis  @default(AFTER_THRESHOLD) @map("bracket_basis")
  notes                  String?       @db.VarChar(500)

  version  StatutoryRuleVersion @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "statutory_components_version_fk")
  brackets TaxThreshold[]

  @@unique([versionId, code])
  @@map("statutory_components")
}

model TaxThreshold {
  id          String   @id @default(uuid()) @db.Char(36)
  componentId String   @map("component_id") @db.Char(36)
  sequence    Int
  upToAnnual  Decimal? @map("up_to_annual") @db.Decimal(18, 2)
  rate        Decimal  @db.Decimal(9, 6)

  component StatutoryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, sequence])
  @@map("tax_thresholds")
}

model PayrollPeriod {
  id          String              @id @default(uuid()) @db.Char(36)
