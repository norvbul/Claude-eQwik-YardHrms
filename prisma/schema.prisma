  payrollRunId      String?        @map("payroll_run_id") @db.Char(36)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  employee  Employee            @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "timesheets_employee_fk")
  approvals TimesheetApproval[]

  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, status, workDate])
  @@map("timesheets")
}

model TimesheetApproval {
  id          String   @id @default(uuid()) @db.Char(36)
