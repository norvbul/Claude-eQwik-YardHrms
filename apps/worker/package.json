{
  "name": "@yardhrms/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker: bulk imports, payslip PDFs, subscription expiry sweeps and leave accruals",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@yardhrms/api": "workspace:*",
    "dotenv": "17.2.3",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": { "@types/node": "22.18.12", "typescript": "5.9.3" }
}
