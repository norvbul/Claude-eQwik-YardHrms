{
  "name": "eqwik-yardhrms",
  "private": true,
  "version": "0.1.0",
  "description": "eQwik YardHRMS(TM) - multi-tenant HR & Payroll SaaS with the Qwik Licence & Subscription Manager",
  "author": "Qwik Business Solutions",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build:packages": "pnpm --filter @yardhrms/authorization --filter @yardhrms/types --filter @yardhrms/payroll-engine run build",
    "build": "pnpm run build:packages && pnpm --filter @yardhrms/api run build && pnpm --filter @yardhrms/worker run build && pnpm --filter @yardhrms/hrms-web run build && pnpm --filter @yardhrms/license-admin-web run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter @yardhrms/api run test:integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "pnpm --filter @yardhrms/api run seed",
    "dev:api": "pnpm --filter @yardhrms/api run dev",
    "dev:worker": "pnpm --filter @yardhrms/worker run dev",
    "dev:hrms": "pnpm --filter @yardhrms/hrms-web run dev",
    "dev:admin": "pnpm --filter @yardhrms/license-admin-web run dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prisma": "6.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "dotenv": "17.2.3",
    "otplib": "12.0.1",
    "@node-rs/argon2": "2.0.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  }
}
