# Environment for the docker-compose stack. Copy to infra/docker/compose.env (gitignored) and fill in.
# Generate each key with:  openssl rand -base64 32
NODE_ENV=production
API_PORT=3000
API_PUBLIC_URL=http://localhost:8080
HRMS_WEB_URL=http://localhost:8080
ADMIN_WEB_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
TRUST_PROXY=true
# Required in production mode. Browsers accept Secure cookies on http://localhost; any other host needs TLS.
COOKIE_SECURE=true

DATABASE_URL=mysql://yard:yard-local-only@mysql:3306/yardhrms
REDIS_URL=redis://redis:6379

FIELD_ENCRYPTION_KEY=
TOKEN_HMAC_KEY=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
MFA_ENFORCEMENT=required
MFA_ISSUER="eQwik YardHRMS"

STORAGE_DRIVER=s3
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=yardhrms-private
S3_ACCESS_KEY_ID=yard-local-s3
S3_SECRET_ACCESS_KEY=yard-local-s3-secret-change-me
S3_FORCE_PATH_STYLE=true
# Server-side encryption request header: AES256 | aws:kms | none. SeaweedFS (local stack) returns ciphertext for SSE-S3 objects, so it is disabled here; the volume is local-only.
S3_SERVER_SIDE_ENCRYPTION=none
MAX_UPLOAD_MB=10

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="eQwik YardHRMS <no-reply@example.com>"

PAYROLL_COMPLIANCE_CERTIFIED=false
PAYMENT_REQUIRE_SEPARATE_VERIFIER=true
WORKER_POLL_MS=2000
WORKER_ID=worker-1

# The migrate container seeds the initial Qwik super admin when RUN_SEED=true.
RUN_SEED=true
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
# Synthetic demo tenants (clearly labelled demo data). Never enable in production.
SEED_DEMO_TENANT=false
