  ruleVersionApproved Boolean          @default(false) @map("rule_version_approved")
  grossTotal          Decimal          @default(0) @map("gross_total") @db.Decimal(18, 2)
  deductionTotal      Decimal          @default(0) @map("deduction_total") @db.Decimal(18, 2)
